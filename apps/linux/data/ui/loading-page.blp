using Gtk 4.0;
using Adw 1;

template $CommitnoteLoadingPage: Adw.NavigationPage {
  title: "Loading";
  tag: "loading";
  can-pop: false;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Adw.StatusPage status_page {
      name: "loading-status";

      child: Gtk.Box actions {
        orientation: vertical;
        spacing: 12;

        Adw.Spinner spinner {
          width-request: 32;
          height-request: 32;
          halign: center;
        }

        Gtk.Box early_draft {
          orientation: vertical;
          spacing: 12;
          margin-top: 12;

          Gtk.Entry early_draft_name_entry {
            name: "early-draft-name-entry";
            placeholder-text: "Name";
          }

          Gtk.Frame {
            child: Gtk.ScrolledWindow {
              min-content-height: 200;
              hscrollbar-policy: never;

              child: Gtk.TextView early_draft_body {
                name: "early-draft-body";
                wrap-mode: word_char;
                top-margin: 8;
                bottom-margin: 8;
                left-margin: 8;
                right-margin: 8;

                accessibility {
                  label: "Note";
                }
              };
            };
          }
        }

        Gtk.Button try_again_button {
          name: "loading-try-again-button";
          label: "Try Again";
          visible: false;
          halign: center;
          css-classes: ["suggested-action", "pill"];
        }

        Gtk.Button log_in_button {
          name: "loading-log-in-button";
          label: "Log In";
          visible: false;
          halign: center;
          css-classes: ["pill"];
        }
      };
    };
  };
}
