using Gtk 4.0;
using Adw 1;

template $CommitnoteLoadingPage: Adw.NavigationPage {
  title: "commitnote";
  tag: "loading";
  can-pop: false;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Gtk.Button {
        name: "loading-new-note-button";
        icon-name: "document-new-symbolic";
        tooltip-text: _("New Note");
        action-name: "win.new-note";

        accessibility {
          label: _("New Note");
        }
      }
    }

    content: Adw.StatusPage status_page {
      name: "loading-status";

      child: Gtk.Box actions {
        orientation: vertical;
        spacing: 12;

        Adw.Spinner spinner {
          width-request: 32;
          height-request: 32;
          halign: center;

          accessibility {
            label: _("Loading");
          }
        }

        Adw.Clamp early_draft {
          name: "early-draft";
          maximum-size: 760;
          visible: false;
          margin-top: 12;

          child: Gtk.Box {
            orientation: vertical;
            spacing: 12;

            Gtk.Entry early_draft_name_entry {
              name: "early-draft-name-entry";
              placeholder-text: "Name";

              accessibility {
                label: _("Note Name");
              }
            }

            Gtk.Frame {
              child: Gtk.ScrolledWindow {
                min-content-height: 200;
                hscrollbar-policy: never;

                child: Gtk.TextView early_draft_body {
                  name: "early-draft-body";
                  wrap-mode: word_char;
                  top-margin: 8;
                  bottom-margin: 8;
                  left-margin: 8;
                  right-margin: 8;

                  accessibility {
                    label: "Note";
                  }
                };
              };
            }
          };
        }

        Gtk.Button try_again_button {
          name: "loading-try-again-button";
          label: "Try Again";
          visible: false;
          halign: center;
          css-classes: ["suggested-action", "pill"];
        }

        Gtk.Button log_in_button {
          name: "loading-log-in-button";
          label: "Log In";
          visible: false;
          halign: center;
          css-classes: ["pill"];
        }
      };
    };
  };
}
