using Gtk 4.0;
using Adw 1;

template $CommitnoteUnusableRepositoryPage: Adw.NavigationPage {
  title: "Repository";
  tag: "unusable";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;

      child: Adw.Clamp {
        maximum-size: 480;
        tightening-threshold: 360;

        child: Gtk.Box {
          orientation: vertical;
          spacing: 24;
          margin-top: 24;
          margin-bottom: 24;
          margin-start: 12;
          margin-end: 12;

          Adw.PreferencesGroup {
            title: "Repository";

            Adw.ActionRow repository_row {
              use-markup: false;
            }
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 12;

            Gtk.Label error_label {
              wrap: true;
              xalign: 0;
              styles ["error"]
            }

            Gtk.Label hint_label {
              visible: false;
              wrap: true;
              xalign: 0;
              use-markup: true;
              styles ["dim-label"]
            }
          }

          Gtk.Box progress_box {
            visible: false;
            spacing: 12;
            halign: center;

            Adw.Spinner {
              width-request: 24;
              height-request: 24;
            }

            Gtk.Label progress_label {
              wrap: true;
            }
          }

          Gtk.Button check_again_button {
            name: "login-check-again-button";
            label: "Check Again";
            halign: center;
            visible: false;
            styles ["pill"]
          }
        };
      };
    };
  };
}
