<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_note"
        android:shortcutId="new-note"
        android:shortcutLongLabel="@string/shortcut_new_note_long"
        android:shortcutShortLabel="@string/shortcut_new_note_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="commitnote://new-note"
            android:targetClass="io.github.marcinjahn.commitnote.MainActivity"
            android:targetPackage="@string/application_id" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutId="search"
        android:shortcutLongLabel="@string/shortcut_search_long"
        android:shortcutShortLabel="@string/shortcut_search_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="commitnote://search"
            android:targetClass="io.github.marcinjahn.commitnote.MainActivity"
            android:targetPackage="@string/application_id" />
    </shortcut>
</shortcuts>
