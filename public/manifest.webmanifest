{
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "name": "commitnote",
  "short_name": "commitnote",
  "description": "Encrypted markdown notes, stored in a Git repository you own.",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity"],
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#fafafa",
  "theme_color": "#fafafa",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "screenshots": [
    { "src": "screenshots/narrow.png", "sizes": "824x1830", "type": "image/png", "form_factor": "narrow", "label": "Notes tree on a phone" },
    { "src": "screenshots/wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Editing a note on desktop" }
  ]
}
