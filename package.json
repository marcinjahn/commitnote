{
  "name": "commitnote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fake": "vite --mode fake-forge",
    "build": "vite build",
    "build:fake": "vite build --mode fake-forge --outDir dist-fake",
    "preview": "vite preview",
    "preview:fake": "vite preview --outDir dist-fake",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:bundle": "npm run build && npm run build:fake && tsx scripts/check-bundle.ts",
    "fixture:sample-notes-repo": "tsx scripts/generate-sample-notes-repo.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@mdit/plugin-tasklist": "^1.1.3",
    "dompurify": "^3.4.16",
    "hash-wasm": "^4.12.0",
    "markdown-it": "^15.0.2",
    "node-diff3": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
