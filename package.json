{
  "name": "commitnote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fake": "vite --mode fake-forge",
    "build": "vite build",
    "build:fake": "vite build --mode fake-forge --outDir dist-fake",
    "preview": "vite preview",
    "preview:fake": "vite preview --outDir dist-fake",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:bundle": "npm run build && npm run build:fake && tsx scripts/check-bundle.ts",
    "fixture:sample-notes-repo": "tsx scripts/generate-sample-notes-repo.ts",
    "generate:wordmark": "tsx scripts/generate-wordmark-svgs.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ia-writer-quattro": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "node-diff3": "^3.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.0.0",
    "fake-indexeddb": "^6.2.5",
    "fontkit": "^2.0.4",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wawoff2": "^2.0.1"
  }
}
