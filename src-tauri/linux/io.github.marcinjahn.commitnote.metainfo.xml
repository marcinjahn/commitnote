<component type="desktop-application">
  <id>io.github.marcinjahn.commitnote</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>commitnote</name>
  <summary>Encrypted markdown notes, stored in a Git repository you own</summary>
  <description>
    <p>commitnote is a markdown note-taking app that encrypts every note on your device before it leaves it.</p>
    <p>Notes are synced to a GitHub or GitLab repository that you own, so your data stays under your control.</p>
    <p>Encryption keys never leave the device.</p>
  </description>
  <developer_name>Marcin Jahn</developer_name>
  <url type="homepage">https://commitnote.eu</url>
  <launchable type="desktop-id">io.github.marcinjahn.commitnote.desktop</launchable>
